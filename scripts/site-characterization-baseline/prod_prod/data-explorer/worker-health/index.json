        "title": "Worker health data for NYC – Environment & Health Data Portal",
        "headingText": [
            "Worker health",
            "Work, Workplaces and Health",
            "Preventing Workplace Injury and Disease",
            "Related data on:",
            "Keywords:",
            "Change topic",
            "About Worker health",
            "Work, Workplaces and Health",
            "Preventing Workplace Injury and Disease",
            "About neighborhood boundaries",
            "About trend charts",
