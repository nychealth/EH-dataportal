{
  "ssg": "hugo",
  "mode": "hosted",
  "build_configuration": {
    "install_command": "[ -f package.json ] && npm i",
    "destination": "docs",
    "baseURL": "/",
    "noTimes": false,
    "hugoVersion": "0.147.3",
    "rubyVersion": "2.7.3",
    "nodeVersion": "20",
    "denoVersion": "1.40.2",
    "environment_variables": [
      {
        "key": "HUGO_CACHEDIR",
        "value": "/usr/local/__site/src/.hugo_cache/"
      }
    ],
    "preserved_paths": "node_modules/,.hugo_cache/,resources/",
    "environment": "dev_stage",
    "source": "",
    "config": "",
    "configDir": "",
    "contentDir": "",
    "layoutDir": "",
    "themesDir": "",
    "theme": "",
    "logFile": "",
    "logLevel": "debug",
    "ignoreVendorPaths": "",
    "disableKinds": "",
    "buildDrafts": false,
    "buildExpired": false,
    "buildFuture": false,
    "cleanDestinationDir": true,
    "debug": false,
    "enableGitInfo": false,
    "gc": true,
    "ignoreCache": false,
    "ignoreVendor": false,
    "log": false,
    "minify": false,
    "noChmod": false,
    "printI18nWarnings": false,
    "printMemoryUsage": false,
    "printPathWarnings": false,
    "printUnusedTemplates": false,
    "quiet": false,
    "templateMetrics": false,
    "templateMetricsHints": false,
    "verbose": false,
    "verboseLog": false,
    "i18nWarnings": false,
    "pathWarnings": false,
    "mem": false,
    "preserveOutput": false,
    "includeGit": true,
    "use_beta_plugin": false,
    "manage_plugin_manually": false
  }
}