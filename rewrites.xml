    <rules>
        
        <!-- ## retired beta prefix ## -->
        
        <!-- The new site ran under beta/ while the old portal held the root. Every
             beta/ path in GA's 404 report resolves once the prefix is dropped
             [checked 2026-10-28 against builds/prod-prod f1e44f21be], and no built
             path starts with beta. The query string is kept, so ?id= survives. -->
            
        <rule name="beta-prefix" stopProcessing="true">
            
            <match url="^beta(?:/(.*))?$" />
            <action type="Redirect" url="/IndicatorPublic/{R:1}" redirectType="Permanent" />
                
        </rule>
                
            
        <!-- ## mangled links ## -->
        
        <!-- Links pasted with punctuation, whitespace or an invisible character after the
             final slash ("heat-report/ U+200B", "hvi/;", "housing-creates-health/U+2060").
             Keep everything up to the last slash that the junk follows. URL Rewrite's
             default ECMAScript syntax makes \s ASCII-only, hence the explicit code points. -->
             
        <rule name="trailing-junk" stopProcessing="true">
            
            <match url="^(.+/)[\s​‌‍⁠﻿;,()'&quot;]+.*$" />
            <action type="Redirect" url="{R:1}" appendQueryString="false" redirectType="Permanent" />
            
        </rule>
        
        <rule name="data-explorer-misspelled" stopProcessing="true">
            
            <match url="^data[ _]?explorer/(.*)$" />
            <action type="Redirect" url="data-explorer/{R:1}" redirectType="Permanent" />
            
        </rule>
        
        <!-- the comma form is what Subtopic-To-DE-Topic sent for subtopic 119 until
             2026-10-28, as a 301, so browsers may still have it cached -->
             
        <rule name="data-explorer-walking-driving-cycling" stopProcessing="true">
            
            <match url="^data-explorer/walking,-driving,-and-cycling/?$" />
            <action type="Redirect" url="data-explorer/walking-driving-and-cycling/" redirectType="Permanent" />
            
        </rule>
        
        <rule name="data-explorer-housing-safety" stopProcessing="true">
            
            <match url="^data-explorer/housing[ _]safety/?$" />
            <action type="Redirect" url="data-explorer/housing-safety/" redirectType="Permanent" />
            
        </rule>
        
        <!-- ## home page ## -->
        
        <rule name="Home" stopProcessing="true">
            
            <match url="(PublicTracking.aspx)" />
            
            <action type="Redirect" url="/IndicatorPublic/" appendQueryString="false" redirectType="Permanent" />
            
        </rule>
        
        
        <!-- ## hub pages ## -->
        
        <!-- Heat Hub -->
        
        <rule name="heat-hub-index" stopProcessing="true">
            
            <match url="HeatHub/index.html" />
            <action type="Redirect" url="key-topics/climatehealth/" redirectType="Permanent" />
            
        </rule>
        
        <rule name="heat-hub-sub" stopProcessing="true">
            
            <match url="HeatHub/(hvi|syndromic)\.(html)" />
            <action type="Redirect" url="key-topics/climatehealth/{R:1}/" redirectType="Permanent" />
            
        </rule>
        
        <!-- Air Quality Hub -->
        
        <rule name="aq-hub-index" stopProcessing="true">
            
            <match url="AQHub/index.html" />
            <action type="Redirect" url="key-topics/airquality/" redirectType="Permanent" />
            
        </rule>
        
        <rule name="aq-hub-aqe" stopProcessing="true">
            
            <match url="AQHub/explorer.html" />
            <action type="Redirect" url="key-topics/airquality/aqe/" redirectType="Permanent" />
            
        </rule>
        
        <rule name="aq-hub-realtime" stopProcessing="true">
            
            <match url="AQHub/realtime.html" />
            <action type="Redirect" url="key-topics/airquality/realtime/" redirectType="Permanent" />
            
        </rule>
        
        
        <!-- ## cold infographic ## -->
        
        <rule name="cold-infographic" stopProcessing="true">
            
            <match url="^cold/?$" />
            <action type="Redirect" url="data-stories/cold/" redirectType="Permanent" />
            
        </rule>
        
        
        <!-- ## data stories ## -->
        
        <rule name="data-stories" stopProcessing="true">
            
            <match url="Closerlook/([a-zA-Z]+)" />
            <action type="Redirect" url="data-stories/{R:1}/" redirectType="Permanent" />
            
        </rule>
        
        
        <!-- ## data explorer topics, using rewrite map ## -->
        
        <rule name="data-explorer-topics" stopProcessing="true">
            
            <match url="Subtopic.aspx" />
            <conditions>
                <add input="{QUERY_STRING}" pattern="subtopic_id=([0-9]+)" />
                <add input="{Subtopic-To-DE-Topic:{C:1}}" pattern="(.+)" />
                
            </conditions>
            <action type="Redirect" url="data-explorer/{C:1}/" appendQueryString="False" redirectType="Permanent" />
            
        </rule>
        
        
        <!-- ## Top-tier pages ## -->
        
        <!-- data explorer landing page -->
        
        <rule name="data-explorer" stopProcessing="true">
            
            <match url="^Subtopic.aspx$" />
            <action type="Redirect" url="data-explorer/" appendQueryString="false" redirectType="Permanent" />
            
        </rule>

        <!-- learn more -->
        
        <rule name="learn-more" stopProcessing="true">
            
            <match url="^(LearnMore|MoreInformation|Glossary)\.aspx$" />
            <action type="Redirect" url="about/" appendQueryString="false" redirectType="Permanent" />
            
        </rule>
        
        <!-- data story landing page -->
        
        <rule name="data-story-landing" stopProcessing="true">
            
            <match url="^Infographic.aspx$" />
            <action type="Redirect" url="data-stories/" appendQueryString="false" redirectType="Permanent" />
            
        </rule>
        
        <!-- other old portal pages -->
        
        <rule name="quick-view" stopProcessing="true">
            
            <match url="^(New)?QuickView\.aspx$" />
            <action type="Redirect" url="data-explorer/" appendQueryString="false" redirectType="Permanent" />
            
        </rule>
        
        <rule name="server-side-report" stopProcessing="true">
            
            <match url="^Report/ServerSideReport\.aspx$" />
            <action type="Redirect" url="neighborhood-reports/" appendQueryString="false" redirectType="Permanent" />
            
        </rule>
        
        <rule name="community-districts" stopProcessing="true">
            
            <match url="^CommunityDistricts\.aspx?$" />
            <action type="Redirect" url="data-stories/geographies/" appendQueryString="false" redirectType="Permanent" />
            
        </rule>
        
        
        <!-- ## old portal downloads, to the page that now covers them ## -->
        
        <rule name="epht-geography-maps" stopProcessing="true">
            
            <match url="^EPHTPDF/(uhf34|uhf42|subboro)\.pdf$" />
            <action type="Redirect" url="data-stories/geographies/" appendQueryString="false" redirectType="Permanent" />
            
        </rule>
        
        <rule name="epht-hvi-faq" stopProcessing="true">
            
            <match url="^EPHTPDF/HVI_?FAQ\.pdf$" />
            <action type="Redirect" url="data-features/hvi/" appendQueryString="false" redirectType="Permanent" />
            
        </rule>
        
        <rule name="epht-lead-definitions" stopProcessing="true">
            
            <match url="^EPHTPDF/Childhood_Lead_Exposure_Definitions[^/]*\.pdf$" />
            <action type="Redirect" url="data-explorer/lead/" appendQueryString="false" redirectType="Permanent" />
            
        </rule>
        
        <!--
            Two NR SPA rules used to sit here and are deliberately gone.

            nr-spa-neighborhood-path rewrote /neighborhood-reports/{topic}/{neighborhood}
            to the topic page, and nr-old-to-new-spa was a permanent 301 turning
            /{neighborhood}/{topic}/ into /{topic}/{neighborhood}. Both existed because the
            SPA served one page per topic and carried the neighborhood in the address bar.

            Every /{neighborhood}/{topic}/ URL is now a real generated page, so the 301
            would redirect away all 210 of them — it has stopProcessing="true" and fires
            before IIS serves a static file. The topic-first shape it redirected *to* never
            reached production and was never in a sitemap, so nothing is being left without
            a redirect [decided 2026-08-06: team].
        -->

        <!-- full neighborhood reports path -->

        <rule name="neighborhood-reports" stopProcessing="true">
            
            <match url="^neighborhood_reports/(.*)" />
            <action type="Redirect" url="neighborhood-reports/{R:1}" appendQueryString="false" redirectType="Permanent" />
            
        </rule>
        
        
        <!-- ## data explorer tabs, using rewrite map ## -->
        
        <!-- Old links are VisualizationData.aspx?id=<IndicatorID>,<hash>,<subtopic_id>,<tab>.
             The topic comes from the indicator, not the subtopic: an indicator's own topic
             is the one page guaranteed to contain it. The rules run from most to least of
             the link preserved, ending at the explorer landing page, so none reach 404.html.
             Visual-?ization also catches the "Visual-izationData" typo that circulates. -->
             
        <rule name="data-explorer-tabs" stopProcessing="true">
            
            <match url="^Visual-?izationData\.aspx$" />
            <conditions trackAllCaptures="true">
                
                <!--pattern => C:1 = internal_id/IndicatorID, C:2 = tab name -->
                <add input="{QUERY_STRING}" pattern="id=([0-9]+),\w*,\d*,([a-zA-Z]+)" />
                <add input="{Indicator-To-DE-Topic:{C:1}}" pattern="(.+)" /> <!-- pattern => C:3 = topic name -->
                <add input="{DE-Tab:{C:2}}" pattern="(.+)" /> <!-- pattern => C:4 = new tab name -->
                
            </conditions>
            <action type="Redirect" url="data-explorer/{C:3}/?id={C:1}#display={C:4}" appendQueryString="False" redirectType="Permanent" />
            
        </rule>
        
        <!-- a tab the DE-Tab map does not know, or no tab at all -->
        
        <rule name="data-explorer-indicator" stopProcessing="true">
            
            <match url="^Visual-?izationData\.aspx$" />
            <conditions trackAllCaptures="true">
                
                <!--pattern => C:1 = IndicatorID -->
                <add input="{QUERY_STRING}" pattern="id=([0-9]+)" />
                <add input="{Indicator-To-DE-Topic:{C:1}}" pattern="(.+)" /> <!-- pattern => C:2 = topic name -->
                
            </conditions>
            <action type="Redirect" url="data-explorer/{C:2}/?id={C:1}" appendQueryString="False" redirectType="Permanent" />
            
        </rule>
        
        <!-- the indicator is no longer on the site, so open its old subtopic's topic without it -->
        
        <rule name="data-explorer-subtopic-only" stopProcessing="true">
            
            <match url="^Visual-?izationData\.aspx$" />
            <conditions trackAllCaptures="true">
                
                <!--pattern => C:1 = subtopic_id -->
                <add input="{QUERY_STRING}" pattern="id=[0-9]*,\w*,([0-9]+)" />
                <add input="{Subtopic-To-DE-Topic:{C:1}}" pattern="(.+)" /> <!-- pattern => C:2 = topic name -->
                
            </conditions>
            <action type="Redirect" url="data-explorer/{C:2}/" appendQueryString="False" redirectType="Permanent" />
            
        </rule>
        
        <rule name="data-explorer-fallback" stopProcessing="true">
            
            <match url="^Visual-?izationData\.aspx$" />
            <action type="Redirect" url="data-explorer/" appendQueryString="False" redirectType="Permanent" />
            
        </rule>
        
    </rules>
    
</rewrite>